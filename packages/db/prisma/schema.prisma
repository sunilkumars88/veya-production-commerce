generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  CUSTOMER_SUPPORT
  FINANCE
  CONTENT_MANAGER
  INVENTORY_MANAGER
  SUPPLIER
  WAREHOUSE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  SUPPLIER_ASSIGNED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  RECEIVED
  QC_PASSED
  QC_FAILED
  REFUNDED
  REPLACED
  REJECTED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  PAYMENT
  WEBHOOK
  REFUND
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Gender {
  WOMEN
  GIRLS
  UNISEX
}

enum AgeGroup {
  ADULT
  TEEN
  CHILD
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(CUSTOMER)
  active       Boolean   @default(true)
  referralCode String?   @unique
  referredBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  wishlists     Wishlist[]
  auditLogs     AuditLog[]
  sessions      UserSession[]
  otpCodes      OtpCode[]
  loyaltyPoints LoyaltyTransaction[]
  supportTickets SupportTicket[]
  notifications NotificationPreference?

  @@index([phone])
  @@index([email])
  @@index([role])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  codeHash  String
  purpose   String   @default("login")
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sort        Int        @default(0)
  active      Boolean    @default(true)
  seoTitle    String?
  seoDescription String?
  products    Product[]
  createdAt   DateTime   @default(now())

  @@index([slug])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  products    ProductCollection[]
  createdAt   DateTime @default(now())

  @@index([slug])
}

model Product {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  shortDescription String?
  fabric           String?
  material         String?
  gender           Gender   @default(WOMEN)
  ageGroup         AgeGroup @default(ADULT)
  benefits         String[]
  features         String[]
  careInstructions String?
  price            Int
  mrp              Int
  costPrice        Int?
  taxRate          Float    @default(5)
  weight           Int?
  dimensions       String?
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  bestSeller       Boolean  @default(false)
  newArrival       Boolean  @default(false)
  returnEligible   Boolean  @default(true)
  exchangeEligible Boolean  @default(true)
  hygieneRestricted Boolean @default(false)
  returnWindowDays Int      @default(7)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]
  shopifyProductId String?  @unique
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  supplierProducts SupplierProduct[]
  reviews          Review[]
  wishlists        Wishlist[]
  collections      ProductCollection[]
  bundleItems      BundleItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([active, featured])
  @@index([active, bestSeller])
  @@index([active, newArrival])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sort         Int        @default(0)

  @@id([productId, collectionId])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String  @unique
  barcode        String?
  size           String
  color          String
  price          Int?
  compareAtPrice Int?
  stock          Int     @default(0)
  reserved       Int     @default(0)
  weightGrams    Int     @default(200)
  active         Boolean @default(true)
  supplierSku    String?
  supplierCost   Int?
  shopifyVariantId String? @unique

  reservations InventoryReservation[]
  cartItems    CartItem[]

  @@index([sku])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sort      Int     @default(0)
  isVideo   Boolean @default(false)
}

// ─── Suppliers & Inventory ───────────────────────────────────────────────────

model Supplier {
  id              String  @id @default(cuid())
  name            String
  email           String?
  phone           String?
  active          Boolean @default(true)
  blindShipping   Boolean @default(true)
  brandPackaging  Boolean @default(true)
  returnAddress   Json?
  dispatchSlaDays Int     @default(2)
  qualityScore    Int     @default(90)
  rtoRate         Float   @default(0)
  returnRate      Float   @default(0)
  createdAt       DateTime @default(now())

  products     SupplierProduct[]
  fulfillments Fulfillment[]
  warehouses   Warehouse[]
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  productId    String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  supplierSku  String
  cost         Int
  stock        Int      @default(0)
  reserved     Int      @default(0)
  leadDays     Int      @default(2)
  moq          Int      @default(1)
  qualityScore Int      @default(90)
  active       Boolean  @default(true)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Warehouse {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  city       String
  state      String
  postalCode String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ─── Addresses ───────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  sessionKey String     @unique
  userId     String?
  items      CartItem[]
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  savedForLater Boolean    @default(false)

  @@unique([cartId, variantId])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentMethod   String      @default("razorpay")
  subtotal        Int
  shipping        Int
  discount        Int         @default(0)
  tax             Int         @default(0)
  codFee          Int         @default(0)
  total           Int
  currency        String      @default("INR")
  address         Json?
  billingAddress  Json?
  notes           String?
  couponCode      String?
  riskLevel       RiskLevel   @default(LOW)
  shopifyOrderId  String?     @unique
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payment      Payment?
  items        OrderItem[]
  fulfillment  Fulfillment?
  shipments    Shipment[]
  returns      ReturnRequest[]
  statusHistory OrderStatusHistory[]
  reservations InventoryReservation[]
  refunds      Refund[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([shopifyOrderId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  title     String
  sku       String
  quantity  Int
  unitPrice Int
  taxAmount Int    @default(0)
  hsnCode   String?

  @@index([orderId])
}

model OrderStatusHistory {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  actorId        String?
  actorType      String      @default("system")
  reason         String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ─── Payments & Refunds ──────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(CREATED)
  amount            Int
  fee               Int           @default(0)
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Int
  reason           String?
  providerRefundId String?
  status           String   @default("pending")
  itemIds          Json?
  createdAt        DateTime @default(now())

  @@index([orderId])
}

// ─── Fulfillment & Shipping ──────────────────────────────────────────────────

model Fulfillment {
  id             String            @id @default(cuid())
  orderId        String            @unique
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  status         FulfillmentStatus @default(PENDING)
  supplierScore  Float?
  trackingNumber String?
  carrier        String?
  raw            Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([supplierId])
  @@index([status])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  awb            String?
  carrier        String?
  status         ShipmentStatus @default(CREATED)
  labelUrl       String?
  eta            DateTime?
  trackingEvents Json?
  raw            Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([awb])
}

// ─── Inventory Reservations ──────────────────────────────────────────────────

model InventoryReservation {
  id        String            @id @default(cuid())
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([status, expiresAt])
}

// ─── Returns ─────────────────────────────────────────────────────────────────

model ReturnRequest {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        ReturnStatus @default(REQUESTED)
  reason        String
  itemIds       Json
  pickupAddress Json?
  refundAmount  Int?
  exchangeVariantId String?
  qcNotes       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id])
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean  @default(false)
  approved         Boolean  @default(false)
  helpfulCount     Int      @default(0)
  images           String[]
  createdAt        DateTime @default(now())

  @@index([productId])
  @@index([approved])
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─── Coupons & Bundles ───────────────────────────────────────────────────────

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  type            DiscountType
  value           Int
  minOrder        Int          @default(0)
  maxDiscount     Int?
  maxUses         Int?
  usedCount       Int          @default(0)
  perUserLimit    Int          @default(1)
  categoryIds     String[]
  productIds      String[]
  firstOrderOnly  Boolean      @default(false)
  active          Boolean      @default(true)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([code])
}

model Bundle {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  type        String       @default("fixed")
  discount    Int          @default(0)
  discountType DiscountType @default(PERCENT)
  minItems    Int          @default(2)
  active      Boolean      @default(true)
  items       BundleItem[]
  createdAt   DateTime     @default(now())
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

// ─── Loyalty & Referrals ─────────────────────────────────────────────────────

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  type      String
  reference String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String
  code       String
  reward     Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([referrerId])
  @@index([code])
}

// ─── Content & CMS ───────────────────────────────────────────────────────────

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  subtitle  String?
  content   Json
  sort      Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  author      String?
  content     String
  excerpt     String?
  image       String?
  tags        String[]
  category    String?
  status      ContentStatus @default(DRAFT)
  seoTitle    String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

model ContentPage {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  content   String
  status    ContentStatus @default(PUBLISHED)
  updatedAt DateTime      @updatedAt
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String?
  sort     Int     @default(0)
  active   Boolean @default(true)
}

// ─── Notifications ───────────────────────────────────────────────────────────

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     Boolean @default(true)
  sms       Boolean @default(true)
  whatsapp  Boolean @default(true)
  marketing Boolean @default(false)
}

model NotificationLog {
  id        String             @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  template  String
  recipient String
  status    NotificationStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([status])
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  orderId    String?
  category   String   @default("Other")
  subject    String
  message    String
  priority   String   @default("normal")
  status     String   @default("open")
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  sessionId String?
  productId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
}

// ─── Webhooks & Audit ────────────────────────────────────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventId     String        @unique
  type        String
  payload     Json
  payloadHash String?
  status      WebhookStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([provider])
  @@index([status])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  method    String
  path      String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Settings & Feature Flags ────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ─── Size Recommendation ─────────────────────────────────────────────────────

model SizeChart {
  id         String @id @default(cuid())
  categoryId String?
  productId  String?
  name       String
  rules      Json
  active     Boolean @default(true)
}
